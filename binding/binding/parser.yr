in parser;

use ymirc::parser;
use ymirc::lint::serialize;
use ymirc::{args, utils::_, errors};
use ymirc::global::_;
use std::{io, conv, fs::path};

use version;
use generator::visitor;


extern (C) fn _yrt_exc_init();
extern (C) fn _yrt_force_debug(f: i32);
extern (C) fn c_binding_fatal_error();

extern (C) fn ymir_binding_init() {
    _yrt_exc_init();

    cte if __version!DEBUG {
        _yrt_force_debug(1);
    }
}


extern (C) fn ymir_binding_parse_ymir_file(filename: [c8]) {
    let nodes = {
        let args = YmirArguments(file-> filename);
        let dmut parser = copy Parser(args);
        parser:.parseAll();
        parser.getExpYILNodes()
    } catch {
        err: &ErrorMsg => {
            println(format("%", err));
            cte if __version!DEBUG {
                for j in err.getRecursiveTrace() {
                    println(j);
                }
            }

            c_binding_fatal_error();
            return;
        }
    };

    // Don't generate symbols if we are generating YIL object files
    if !global::state::isExportYIL() {
        let mut generator = GenerateVisitor();
        for n in nodes {
            generator:.generate(n);
        }
    }
}

extern (C) fn ymir_binding_parse_yil_file(filename: Path, ref mut importer: YILImporter) {
    // We don't import YIL if exporting yil, it's useless
    if !state::isExportYIL() {
        importer:.import(filename);
    }
} catch {
    err: &ErrorMsg => {
        println(format("%", err));
        cte if __version!DEBUG {
            for j in err.getRecursiveTrace() {
                println(j);
            }
        }

        c_binding_fatal_error();
        return;
    }
}

extern (C) fn ymir_binding_parse_file(nb_files: u32, filenames: *(*c8)) {
    let mut importer = YILImporter();

    for i in 0u32 .. nb_files {
        let filename = filenames[i].fromStringZ();
        let filePath = Path(filename);
        if filePath.extension() == CommonVars::YIL_EXTENSION {
            ymir_binding_parse_yil_file(filePath, ref importer);
        } else {
            ymir_binding_parse_ymir_file(filename);
        }
    }

    if !importer.isEmpty() {
        let mut generator = GenerateVisitor();
        for n in importer.getNodes() {
            generator:.generate(n);
        }
    }
}

extern (C) fn ymir_binding_d_add_builtin_version(version: *c8) {
    let v = version.fromStringZ();
    for d_v in D_VERSIONS::__members__ {
        if d_v._0 == v {
            state::addVersion(d_v._1);
            return;
        }
    }
}

extern (C) fn ymir_binding_set_size_type(size: u32) {
    state::setPointerArchSize(size);
}

extern (C) fn ymir_binding_set_float_size_type(size: u32) {
    state::setFloatArchSize(size);
}

extern (C) fn ymir_binding_activate_debug(a: bool) {
    if (a) {
        state::activateDebug();
        state::addVersion(Versions::DEBUG);
    }
}

extern (C) fn ymir_binding_activate_verbose(a: bool) {
    if (a)
        state::activateVerbose();
}

extern (C) fn ymir_binding_activate_standalone(a: bool) {
    if (a) {
        state::activateStandalone();
        state::addVersion(Versions::STANDALONE);
    }
}

extern (C) fn ymir_binding_activate_include_testing(a: bool) {
    if (a) {
        state::activateUnittest();
        state::addVersion(Versions::UNITTEST);
    }
}

extern (C) fn ymir_binding_deactivate_testing_coverage(a: bool) {
    if (a) {
        state::deactivateCodeCoverage();
    }
}

extern (C) fn ymir_binding_activate_doc_dumping(file: *c8) {
    state::activateDocDumping(Path(fromStringZ(file)));
}

extern (C) fn ymir_binding_activate_export_yil(file: *c8) {
    state::activateYILExport(Path(fromStringZ(file)));
}

extern (C) fn ymir_binding_add_include_dir(dir: *c8) {
    state::addIncludeDir(fromStringZ(dir));
}

extern (C) fn ymir_binding_add_version(ver: *c8) {
    state::addVersion(fromStringZ(ver));
}

extern (C) fn ymir_binding_set_prefix(pref: *c8) {
    state::setPrefix(fromStringZ(pref));
}

extern (C) fn ymir_binding_set_executable_name(name: *c8) {
    state::setExecutable(fromStringZ(name));
}

extern (C) fn ymir_binding_activate_ymir_dumping(a: bool) {
    if (a) {
        state::activateYmirDumping();
    }
}

extern (C) fn ymir_binding_activate_import_dumping(a: bool) {
    if (a) {
        state::activateSymTreeDumping();
    }
}

extern (C) fn ymir_binding_insert_filtering_module(name: *c8) {
    state::insertPathFilter(Path(fromStringZ(name)).stripExtension());
}

extern (C) fn ymir_binding_activate_dependency_dumping(loc: *c8) {
    state::activateDependencyDumping(Path(fromStringZ(loc)));
}
