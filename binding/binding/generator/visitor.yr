in visitor;

use ymirc::lint::node::{_, global::_, instr::_, type::_, value::_};
use ymirc::global::_;
use ymirc::utils::_;
use ymirc::lexing::{word, keys};
use binding::tree::_;

use std::io;

/**
 * This generator class transform ymirc YIL nodes into GCC trees
 */
pub record GenerateVisitor {

    /**
     * ================================================================================
     * ================================================================================
     * =============================        CONTEXT        ============================
     * ================================================================================
     * ================================================================================
     */

    // The list of defined frames
    let mut _definedFrame: [[c8] => mut()] = copy [];

    // The var decl stack of each block
    let mut _stackVarDeclChain: [dmut &TreeChain] = [];

    // The stack of blocks
    let mut _stackBlockChain: [dmut &BlockChain] = [];

    // The function being generated
    let mut _currentFunctionContext: tree_t = null;

    // The declaration of the variable in the current function context id => varDeclTree
    let mut _varDecls: [mut[usize => mut tree_t]] = [];

    // The declaration of the labels in the current function context id => labelDecl
    let mut _labels: [mut[usize => mut tree_t]] = [];

    // The location of the block opening / closing
    let mut _blockLocs: [mut &Word] = [];

    // The list of validated tuples
    let mut _generatedTypes: [usize => mut tree_t] = copy [];

    prv { // Tuple validation

        // The list of finalized tuple types
        let mut _finalizedTuples: [usize => mut tree_t] = copy [];

        // The list of tuples to finalize
        let mut _toFinalize: [usize => mut(tree_t, [usize], bool, bool, u32)] = copy [];

        let dmut _tupleRecursiveLevel: [usize => u32] = copy [];

    }

    /**
     * ================================================================================
     * ================================================================================
     * ==============================        CTORS        =============================
     * ================================================================================
     * ================================================================================
     */


    /**
     * Create a new empty generator
     */
    pub self () {}


    /**
     * Generate the GCC trees from gen
     * @params:
     *    - gen: the generator to transform
     */
    pub fn generate(mut self, gen: &YILNode) {
        match gen {
            f: &YILFrame => {
                self:.generateFrame(f);
            }
            c: &YILConstant => {
                self:.generateConstant(c);
            }
            g: &YILGlobalVar => {
                self:.generateGlobalVar(g);
            }
            _ => {
                eprintln(gen.__typeinfo__.name);
                eprintln(format("%", gen));
                panic;
            }
        }
    }

    /**
     * ================================================================================
     * ================================================================================
     * ===============================         FRAMES         =========================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Generate a frame from a frame generator.
     * @params:
     *    - frame: the frame to generate
     * */
    fn generateFrame(mut self, frame: &YILFrame) {
        let fnDecl = self:.generateFunctionDecl(frame);
        let asmName = decl::getAsmName(fnDecl);

        logging::info("Generate frame %"s8, frame.name);

        self:.setCurrentFunctionContext(fnDecl);
        self:.enterFrame();

        let args = self:.generateFrameArguments(frame);
        let resDecl = decl::buildResultDecl(frame.loc, self:.generateType(frame.retType));
        decl::setDeclArguments(fnDecl, args);

        c_binding_set_result_decl(fnDecl, resDecl);

        let bodyLoc = frame.body.loc;

        // We need to enter a block, even if function body is already a block
        // because we need a bind for the function
        self:.enterBlock(bodyLoc);
        let mut bodyLst = TreeStatementList();
        self:.generateInstr(frame.body, ref bodyLst);

        let (bind, body) = self:.quitBlock(bodyLoc, bodyLst.getTree());

        c_binding_set_block_super_context(body, fnDecl);
        c_binding_set_decl_initial(fnDecl, body);
        c_binding_set_decl_saved_tree(fnDecl, bind);
        c_binding_set_external(fnDecl, false);
        c_binding_set_preserved(fnDecl, true);
        if (frame.isGlobalCtor) {
            c_binding_set_public(fnDecl, false);
            c_binding_set_global_ctor(fnDecl, true);
        } else {
            c_binding_set_public(fnDecl, true);
        }

        c_binding_set_static(fnDecl, true);
        c_binding_set_weak(fnDecl, frame.isWeak);

        self:.quitFrame();
        self:.setCurrentFunctionContext(null);
        self._definedFrame[asmName] = ();

        c_binding_gimplify_function(fnDecl);
        c_binding_finalize_function(fnDecl);
    }

    /**
     * Generate a function declaration from a frame generator
     * */
    fn generateFunctionDecl(mut self, frame: &YILFrame)-> tree_t {
        let params = frame.params;

        let args = copy [self:.generateType(p.type) for p in params];
        let ret = self:.generateType(frame.retType);
        let fnType = types::functionTypeTree(ret, args);
        let fnDecl = decl::functionDeclTree(EOF_WORD, frame.name, fnType);
        decl::setAsmName(fnDecl, frame.name);

        return fnDecl;
    }

    /**
     * Generate the parameter variables of a frame
     * @assume: a function context is entered
     * @params:
     *     - frame: the frame being generated
     * @returns: the list of tree containing the parameters
     * */
    fn generateFrameArguments(mut self, frame: &YILFrame)-> [tree_t] {
        copy [{
            let type = self:.generateType(v.type);

            let var = decl::paramDeclTree(v.loc, v.name, type);
            self:.insertVariable(v.id, var);

            c_binding_set_decl_context(var, self.getCurrentFunctionContext());
            c_binding_set_arg_type(var, type);
            c_binding_set_used(var, true);

            var
        } for v in frame.params]
    }

    /**
     * ================================================================================
     * ================================================================================
     * ==============================         CONSTANT         ========================
     * ================================================================================
     * ================================================================================
     */


    /**
     * Declare a constant value in the text segment
     * */
    fn generateConstant(mut self, cst: &YILConstant) {
        let value = self:.generateValue(cst.value);
        let type = c_binding_get_type(value);

        logging::info("Generate constant %"s8, cst.name);

        let var = decl::varDeclTree(cst.loc, cst.name, type);
        c_binding_set_decl_initial(var, value);
        c_binding_set_decl_context(var, tree::decl::ymir_get_global_context());

        c_binding_set_static(var, true);
        c_binding_set_public(var, !cst.isLocal);
        c_binding_set_constant(var, true);
        c_binding_set_readonly(var, true);
        c_binding_set_used(var, true);
        c_binding_set_addressable(var, true);
        c_binding_set_weak(var, cst.isWeak);

        c_binding_insert_global(var);
    }

    /**
     * ================================================================================
     * ================================================================================
     * =============================         GLOBAL VAR         =======================
     * ================================================================================
     * ================================================================================
     */

    /**
     * Declare a global variable in the data segment
     * */
    fn generateGlobalVar(mut self, gv: &YILGlobalVar) {
        let value = self:.generateValue(gv.value);
        let type = c_binding_get_type(value);

        logging::info("Generate global var %"s8, gv.name);

        let var = decl::varDeclTree(gv.loc, gv.name, type);
        c_binding_set_decl_context(var, tree::decl::ymir_get_global_context());
        c_binding_set_decl_initial(var, value);
        if (gv.isThreadLocal) {
            c_binding_set_thread_local(var);
        }

        c_binding_set_static(var, true);
        c_binding_set_constant(var, false);
        c_binding_set_readonly(var, false);
        c_binding_set_used(var, true);
        c_binding_set_addressable(var, true);
        c_binding_set_public(var, true);
        c_binding_set_weak(var, gv.isWeak);

        c_binding_insert_global(var);
    }

    /**
     * =========================================================================
     * =========================================================================
     * ========================           TYPES           ======================
     * =========================================================================
     * =========================================================================
     * */

    /**
     * Generate a type tree from a YILType
     * */
    fn generateType(mut self, type: &YILType, fromPointer: bool = false)-> tree_t {
        match type {
            // Compounds
            a: &YILArray => { return self:.generateArrayType(a); }
            t: &YILTuple => { return self:.generateTupleType(t, fromPointer); }
            p: &YILPointer => { return self:.generatePointerType(p); }

            // Scalars
            f: &YILFloat => { return types::floatTypeTree(cast!i32(f.size * 8u32)); }
            i: &YILInt => { return types::intTypeTree(cast!i32(i.size * 8u32), i.signed); }
            YILVoid() => { return types::voidTypeTree(); }
            _ => {
                eprintln(type.__typeinfo__.name);
                panic;
            }
        }
    }

    /**
     * Gneerate a type tree from a YILArray
     * */
    fn generateArrayType(mut self, type: &YILArray)-> tree_t {
        if let Ok(t) = self._generatedTypes[type.uid] {
            return t;
        }

        let inner = self:.generateType(type.inner);
        let t = c_binding_build_array_type(inner, cast!u64(type.len));
        self._generatedTypes[type.uid] = t;
        return t;
    }

    /**
     * Generate a type tree from a tuple type
     * */
    fn generateTupleType(mut self, type: &YILTuple, fromPointer: bool)-> tree_t {
        if let Ok(t) = self._finalizedTuples[type.uid] {
            return t;
        }

        if let Ok((base, __ig__...)) = self._toFinalize[type.uid] {
            return base;
        }

        let lvl = if let Ok(r) = self._tupleRecursiveLevel[type.uid] {
            r
        } else {
            0
        };

        self._tupleRecursiveLevel[type.uid] = lvl + 1;

        {
            let base = if let Ok(t) = self._generatedTypes[type.uid] {
                t
            } else {
                types::prepareTupleTypeTree(format("tuple_%", type.uid), isUnion-> type.isUnion)
            };

            if fromPointer && lvl != 0 {
                return base;
            }

            self._generatedTypes[type.uid] = base;
            let inners = copy [self:.generateType(ti) for ti in type.inners];

            // Recursive already set the inner fields
            if type.uid in self._toFinalize || type.uid in self._finalizedTuples {
                return base;
            }

            types::setTupleFieldsTree(base, inners, type.fieldNames);
            let dependencies = self.listDependencies(copy [ti.uid for ti in type.inners]);
            if  dependencies.len == 0 {
                types::finalizeTupleTypeTree(base, isUnion-> type.isUnion, isPacked-> type.isPacked, size-> type.size);
                self._finalizedTuples[type.uid] = base;
            } else {
                self._toFinalize[type.uid] = (base, dependencies, type.isUnion, type.isPacked, type.size);
            }

            return base;

        } exit {
            if lvl != 0 {
                self._tupleRecursiveLevel[type.uid] = lvl;
            } else {
                self._tupleRecursiveLevel:.remove(type.uid);
            }

            self:.finalizeTupleTypes(self._tupleRecursiveLevel.len == 0);
        }
    }

    /**
     * Generate a type tree from a pointer type
     * */
    fn generatePointerType(mut self, type: &YILPointer)-> tree_t {
        if let Ok(t) = self._generatedTypes[type.uid] {
            return t;
        }

        let inner = self:.generateType(type.inner, fromPointer-> true);
        let ret = types::pointerTypeTree(inner);
        self._generatedTypes[type.uid] = ret;
        ret
    }

    /**
     * Finalize the tuple types that may be recursively dependent
     * */
    fn finalizeTupleTypes(mut self, force: bool) {
        let lst = self:.createTupleDependencyList(force);
        for l in lst {
            types::finalizeTupleTypeTree(l._0, isUnion-> l._1, isPacked-> l._2, size-> l._3);
            self._finalizedTuples[l._4] = l._0;
        }
    }

    fn listDependencies(self, lst: [usize])-> [usize] {
        let dmut res: [usize] = [];
        for l in lst {
            if l in self._toFinalize { res ~= [l]; }
        }

        res
    }

    fn createTupleDependencyList(mut self, force: bool)-> [(tree_t, bool, bool, u32, usize)] {
        let dmut result: [(tree_t, bool, bool, u32, usize)] = [];

        while self._toFinalize.len != 0 {
            let mut fnd: (usize, tree_t, bool, bool, u32) = (0, null, false, false, 0);
            let mut lst: (usize, tree_t, bool, bool, u32) = (0, null, false, false, 0);
            for id, l in self._toFinalize {
                let mut found = true;
                for z in l._1 {
                    if z in self._toFinalize {
                        found = false;
                        break;
                    }
                }

                if found {
                    fnd = (id, l._0, l._2, l._3, l._4);
                    break;
                }

                lst = (id, l._0, l._2, l._3, l._4);
            }

            if fnd._1 == null {
                if force { fnd = lst; }
                else {
                    break;
                }
            }

            self._toFinalize:.remove(fnd._0);
            result ~= [(fnd._1, fnd._2, fnd._3, fnd._4, fnd._0)];
        }

        result
    }

    /**
     * =========================================================================
     * =========================================================================
     * ========================           VALUES           =====================
     * =========================================================================
     * =========================================================================
     * */

    /**
     * Generate a value tree from a Value generator
     * */
    fn generateValue(mut self, value: &YILValue)-> tree_t {
        match value {
            a: &YILArrayAccessValue => { return self:.generateArrayAccess(a); }
            a: &YILAddrValue => { return self:.generateAddr(a); }
            a: &YILArrayValue => { return self:.generateArrayLit(a); }
            s: &YILStringValue => { return self.generateStringLit(s); }
            b: &YILBinaryValue => { return self:.generateBinary(b); }
            c: &YILCastValue => { return self:.generateCast(c); }
            f: &YILFieldValue => { return self:.generateField(f); }
            f: &YILFloatValue => { return self:.generateFloat(f); }
            i: &YILIntValue => { return self:.generateInt(i); }
            c: &YILNameCallValue => { return self:.generateNameCall(c); }
            c: &YILPtrCallValue => { return self:.generatePtrCall(c); }
            t: &YILTupleValue => { return self:.generateTupleValue(t); }
            u: &YILUnaryValue => { return self:.generateUnary(u); }
            v: &YILVar => { return self:.generateVarValue(v); }
            u: &YILUnrefValue => { return self:.generateUnref(u); }
            b: &YILBeginCatch => { return self:.generateBeginCatch(b); }
            _ => {
                eprintln(value.__typeinfo__.name);
                panic;
            }
        }
    }

    /**
     * Transform a YIL array access into a tree_t
     * */
    fn generateArrayAccess(mut self, value: &YILArrayAccessValue)-> tree_t {
        let arr = self:.generateValue(value.value);
        let index = self:.generateValue(value.index);

        return expr::arrayAccessExprTree(value.loc, arr, index);
    }

    /**
     * Transform a YIL Addr into a tree_t
     * */
    fn generateAddr(mut self, value: &YILAddrValue)-> tree_t {
        let type = self:.generateType(value.type);
        let inner = self:.generateValue(value.value);

        c_binding_set_addressable(inner, true);
        return expr::addressExprTree(value.loc, type, inner);
    }

    /**
     * Transform a YIL array literal into a tree_t
     * */
    fn generateArrayLit(mut self, value: &YILArrayValue)-> tree_t {
        let type = self:.generateType(value.type);
        let params = copy [self:.generateValue(i) for i in value.value];
        return expr::buildConstructorIndexed(type, params);
    }

    /**
     * Transform a YIL string literal into a tree_t
     * */
    fn generateStringLit(self, value: &YILStringValue)-> tree_t {
        c_binding_build_string_literal(cast!u64(value.value.len), value.value.ptr)
    }

    /**
     * Transform a YIL binary op into a tree_t
     * */
    fn generateBinary(mut self, value: &YILBinaryValue)-> tree_t {
        let left = self:.generateValue(value.left);
        let right = self:.generateValue(value.right);
        let type = self:.generateType(value.type);

        return expr::binaryExprTree(value.loc, value.op, type, left, right);
    }

    /**
     * Transform a YIL cast into a tree_t
     * */
    fn generateCast(mut self, value: &YILCastValue)-> tree_t {
        let type = self:.generateType(value.type);
        let inner = self:.generateValue(value.value);

        return expr::castExprTree(value.loc, type, inner);
    }

    /**
     * Transform a YIL field access into a tree_t
     * */
    fn generateField(mut self, value: &YILFieldValue)-> tree_t {
        let inner = self:.generateValue(value.tuple);

        let name = if value.name.len == 0us {
            format("_%", value.index)
        } else { value.name };

        return expr::fieldAccessExprTree(value.loc, inner, name);
    }

    /**
     * Transform a YIL float literal into a tree_t
     * */
    fn generateFloat(mut self, value: &YILFloatValue)-> tree_t {
        let type = self:.generateType(value.type);
        let bf = value.value;
        if (bf.isNan) {
            return expr::buildNanCst(type);
        } else if (bf.isPositiveInf) {
            return expr::buildInfPosCst(type);
        } else if (bf.isNegativeInf) {
            return expr::buildInfNegCst(type);
        } else {
            return expr::buildFloatCst(type, bf.toHexString());
        }
    }

    /**
     * Transform a YIL Int literal into a tree_t
     * */
    fn generateInt(mut self, value: &YILIntValue)-> tree_t {
        let type = self:.generateType(value.type);
        let bi = value.value;
        if let i: &YILInt = value.type && i.signed {
            return expr::buildIntCst(type, bi.toN!{i64} ());
        } else {
            return expr::buildIntCst(type, bi.toN!{u64} ());
        }
    }

    /**
     * Transform a YIL Name call into a tree_t
     * */
    fn generateNameCall(mut self, value: &YILNameCallValue)-> tree_t {
        let retType = self:.generateType(value.type);
        let params = copy [self:.generateValue(pi) for pi in value.params];
        return expr::callExprTree(value.loc, retType, value.funcName, params);
    }

    /**
     * Transform a YIL Ptr call into a tree
     * */
    fn generatePtrCall(mut self, value: &YILPtrCallValue)-> tree_t {
        let retType = self:.generateType(value.type);
        let params = copy [self:.generateValue(pi) for pi in value.params];
        let types  = copy [c_binding_get_type(pt) for pt in params];

        let func = self:.generateValue(value.funcPtr);
        let fnType = tree::types::pointerTypeTree(c_binding_build_function_type(retType, cast!u64(types.len), types.ptr));
        let fptr = expr::castExprTree(value.loc, fnType, func);

        return expr::callExprTree(value.loc, retType, fptr, params);
    }

    /**
     * Transform a YIL tuple into a tree_t
     * */
    fn generateTupleValue(mut self, value: &YILTupleValue)-> tree_t {
        let type = self:.generateType(value.type);
        let params = copy [self:.generateValue(pi) for pi in value.values];
        return expr::buildConstructorFields(type, params, value.fieldNames);
    }

    /**
     * Transform a YIL unary op into a tree_t
     * */
    fn generateUnary(mut self, value: &YILUnaryValue)-> tree_t {
        let val = self:.generateValue(value.left);
        let type = self:.generateType(value.type);

        return expr::unaryExprTree(value.loc, value.op, type, val);
    }

    /**
     * Transfrom a unit value into a tree_t
     * */
    fn generateUnit(self, _: &YILUnit)-> tree_t {
        null
    }

    /**
     * Transform a YIL unref into a tree_t
     * */
    fn generateUnref(mut self, value: &YILUnrefValue)-> tree_t {
        let val = self:.generateValue(value.value);
        let type = self:.generateType(value.type);

        return c_binding_unref_pointer(expr::castExprTree(value.loc, types::pointerTypeTree(type), val), 0u64);
    }


    fn generateVarValue(mut self, value: &YILVar)-> tree_t {
        if (value.id != 0us) { // local variable
            match self.getVariable(value.id) {
                Ok(v: _) => return v;
                _ => panic;
            }
        }

        // Else it is a global ref
        let type = self:.generateType(value.type);

        let var = decl::varDeclTree(value.loc, value.name, type);
        c_binding_set_external(var, true);
        if (value.isThreadLocal) {
            c_binding_set_thread_local(var);
        }

        return var;
    }

    /**
     * Generate a begin catch expression
     * */
    fn generateBeginCatch(mut self, value: &YILBeginCatch)-> tree_t {
        let ehptrT = c_binding_build_call_ehptr();
        let catchType = pointerTypeTree(voidTypeTree());
        return expr::callExprTree(value.loc, catchType, value.name, copy [ehptrT]);
    }

    /**
     * =========================================================================
     * =========================================================================
     * ========================           INSTR           =====================
     * =========================================================================
     * =========================================================================
     * */


    /**
     * Transform a YIL instruction into a tree_t
     * */
    fn generateInstr(mut self, instr: &YILInstr, ref mut list: TreeStatementList) {
        match instr {
            a: &YILAffect => { self:.generateAffect(a, ref list); }
            b: &YILBlock => { self:.generateBlock(b, ref list); }
            c: &YILCall => { self:.generateCall(c, ref list); }
            c: &YILCondJmp => { self:.generateCondJmp(c, ref list); }
            g: &YILGoto => { self:.generateGoto(g, ref list); }
            l: &YILLabel => { self:.generateLabel(l, ref list); }
            r: &YILReturn => { self:.generateReturn(r, ref list); }
            v: &YILVarDecl => { self:.generateVarDecl(v, ref list); }
            t: &YILTryFinally => { self:.generateTryFinally(t, ref list); }
            c: &YILTryCatch => { self:.generateTryCatch(c, ref list); }
            _ => {
                eprintln(instr.__typeinfo__.name);
                panic;
            }
        }
    }

    /**
     * Transform a YIL affectation into a tree_t
     * */
    fn generateAffect(mut self, aff: &YILAffect, ref mut list: TreeStatementList) {
        let left = self:.generateValue(aff.left);
        let right = self:.generateValue(aff.right);

        let ret = expr::affectExprTree(aff.loc,
                                       left,
                                       right,
                                       self:.getStackVarDeclChain(),
                                       self.getCurrentFunctionContext());
        list:.append(ret);
    }

    /**
     * Transform a YIL block into a tree_t
     * */
    fn generateBlock(mut self, b: &YILBlock, ref mut list: TreeStatementList) {
        let mut blockList = TreeStatementList();
        self:.enterBlock(b.loc);
        for i in b.instrs {
            self:.generateInstr(i, ref blockList);
        }

        let (bl, _) = self:.quitBlock(b.loc, blockList.getTree());
        list:.append(bl);
    }

    /**
     * Transform a YIL call into a tree_t
     * */
    fn generateCall(mut self, c: &YILCall, ref mut list: TreeStatementList) {
        let value = self:.generateValue(c.content);
        list:.append(value);
    }

    /**
     * Transform a YIL conditional jump into a tree_t
     * */
    fn generateCondJmp(mut self, c: &YILCondJmp, ref mut list: TreeStatementList) {
        let labelThen = self:.retreiveLabel(c.then);
        let labelElse = self:.retreiveLabel(c.else_);
        let gotoThen = expr::gotoExprTree(c.loc, labelThen);
        let gotoElse = expr::gotoExprTree(c.loc, labelElse);

        let test = self:.generateValue(c.cond);

        let c_loc = wordToLocation(c.loc);
        list:.append(c_binding_build_cond_expr(c_loc, test, gotoThen, gotoElse));
    }

    /**
     * Transform a YIL goto into a tree_t
     * */
    fn generateGoto(mut self, c: &YILGoto, ref mut list: TreeStatementList) {
        let lbl = self:.retreiveLabel(c.label);
        list:.append(expr::gotoExprTree(c.loc, lbl));
    }

    /**
     * Transform a YIL label into a tree_t
     * */
    fn generateLabel(mut self, c: &YILLabel, ref mut list: TreeStatementList) {
        let lbl = self:.retreiveLabel(c);
        list:.append(expr::labelExprTree(c.loc, lbl));
    }

    /**
     * Retreive the label declaration, or declare a new label
     * We need that, because we can goto a label that is not declared in the frame yet
     * @example:
     * ==========
     * goto LBL;
     * LBL:
     * ==========
     * * */
    fn retreiveLabel(mut self, c: &YILLabel)-> tree_t {
        match self.getLabel(c.id) {
            Ok(l: tree_t) => return l;
        }

        let lbl = decl::labelDeclTree(c.loc, self.getCurrentFunctionContext(), c.name);
        self:.insertLabel(c.id, lbl);

        lbl
    }

    /**
     * Transform a YIL return into a tree_t
     * */
    fn generateReturn(mut self, c: &YILReturn, ref mut list: TreeStatementList) {
        match c.value {
            YILUnit() => {
                list:.append(expr::returnExprTree(c.loc));
            }
            val: _ => {
                let ret = c_binding_get_result_decl(self.getCurrentFunctionContext());
                let inner = self:.generateValue(val);
                list:.append(expr::returnExprTree(c.loc, ret, inner));
            }
        }
    }

    /**
     * Transform a YIL variable declaration into a tree_t
     * */
    fn generateVarDecl(mut self, v: &YILVarDecl, ref mut list: TreeStatementList) {
        let type = self:.generateType(v.type);
        let var = decl::varDeclTree(v.loc, v.name, type);
        c_binding_set_decl_context(var, self.getCurrentFunctionContext());

        self:.getStackVarDeclChain():.append(var);
        self:.insertVariable(v.id, var);

        let decl = decl::buildDeclTree(v.loc, types::voidTypeTree(), var);
        list:.append(decl);
    }

    /**
     * Transform a YIL Try finally declaration into a tree_t
     * */
    fn generateTryFinally(mut self, t: &YILTryFinally, ref mut list: TreeStatementList) {
        let mut tryList = TreeStatementList();
        let mut finallyList = TreeStatementList();

        self:.enterBlock(t.loc);
        for i in t.tryPart {
            self:.generateInstr(i, ref tryList);
        }
        let (tr, _) = self:.quitBlock(t.loc, tryList.getTree());

        self:.enterBlock(t.loc);
        for i in t.finPart {
            self:.generateInstr(i, ref finallyList);
        }
        let (fin, _) = self:.quitBlock(t.loc, finallyList.getTree());

        list:.append(buildTryFinally(t.loc, tr, fin));
    }

    /**
     * Transform a YIL Try catch declaration into a tree_t
     * */
    fn generateTryCatch(mut self, t: &YILTryCatch, ref mut list: TreeStatementList) {
        let mut tryList = TreeStatementList();
        let mut catchList = TreeStatementList();

        self:.enterBlock(t.loc);
        for i in t.tryPart {
            self:.generateInstr(i, ref tryList);
        }
        let (tr, _) = self:.quitBlock(t.loc, tryList.getTree());

        self:.enterBlock(t.loc);
        for i in t.catchPart {
            self:.generateInstr(i, ref catchList);
        }
        let (ct, _) = self:.quitBlock(t.loc, catchList.getTree());

        let mut catchers = TreeStatementList();
        catchers:.append(buildCatcherExpr(t.loc, ct));

        list:.append(buildTryCatch(t.loc, tr, catchers.getTree()));
    }

    /**
     * =========================================================================
     * =========================================================================
     * ======================           MANAGEMENT           ===================
     * =========================================================================
     * =========================================================================
     * */

    /**
     * Set the context of the generation
     * @params:
     *     - fnDecl: the function being generated
     * */
    pub fn setCurrentFunctionContext(mut self, fnDecl: tree_t) {
        self._currentFunctionContext = fnDecl;
    }

    /**
     * @returns: the GCC tree of the function being currently generated
     * */
    pub fn getCurrentFunctionContext(self)-> tree_t {
        self._currentFunctionContext
    }

    /**
     * Enter a new frame generation
     * */
    pub fn enterFrame(mut self) {
        self._varDecls ~= [cast!{[usize => tree_t]} (copy [])];
        self._labels   ~= [cast!{[usize => tree_t]} (copy [])];
    }

    /**
     * Quit the frame being validated
     * */
    pub fn quitFrame(mut self) {
        self._varDecls = alias self._varDecls[0 .. $ - 1];
        self._labels   = alias self._labels[0 .. $ - 1];
    }

    /**
     * Enter a block
     * */
    pub fn enterBlock(mut self, loc: &Word) {
        self._stackBlockChain ~= [copy BlockChain()];
        self._stackVarDeclChain ~= [copy TreeChain()];
        self._blockLocs ~= [loc];
    }

    /**
     * Quit a block
     * @params:
     *     - loc: the location of the block
     *     - content: the list of expression to put inside the block to quit
     * */
    pub fn quitBlock(mut self, loc: &Word, content: tree_t)-> (tree_t, tree_t) {
        let blkLoc = self._blockLocs[$ - 1us];
        if (blkLoc != loc) panic;

        let varChain = self._stackVarDeclChain[$ - 1];
        let dmut blkChain = alias self._stackBlockChain[$ - 1];

        self._stackBlockChain = alias self._stackBlockChain[0 .. $ - 1];
        self._stackVarDeclChain = alias self._stackVarDeclChain[0 .. $ - 1];
        self._blockLocs = alias self._blockLocs[0 .. $ - 1];

        let block = expr::blockTree(loc, varChain.getTree(), blkChain.getTree());
        let bind = expr::bindTree(loc, varChain.getTree(), content, block);

        blkChain:.setSuperContext(block);

        (bind, block)
    }

    /**
     * @returns: the stack var decl chain of the current block
     * */
    pub fn getStackVarDeclChain(mut self)-> dmut &TreeChain {
        return alias(self._stackVarDeclChain[$ - 1us]);
    }

    /**
     * @returns: the block chain of the current block
     * */
    pub fn getBlockChain(mut self)-> dmut &BlockChain {
        return alias(self._stackBlockChain[$ - 1us]);
    }

    /**
     * Insert a variable declaration
     * */
    pub fn insertVariable(mut self, id: usize, var: tree_t) {
        self._varDecls[$ - 1us][id] = var;
    }

    /**
     * Get a variable by its reference id
     * @returns: the variable declaration if any
     * */
    pub fn getVariable(self, id: usize)-> (tree_t)? {
        self._varDecls[$ - 1us][id]
    }

    /**
     * Insert a label declaration
     * */
    pub fn insertLabel(mut self, id: usize, lbl: tree_t) {
        self._labels[$ - 1us][id] = lbl;
    }

    /**
     * @returns: the label declaration if any
     * */
    pub fn getLabel(self, id: usize)-> (tree_t)? {
        self._labels[$ - 1us][id]
    }
}
