in decl;

use ymirc::lexing::word;
use binding::tree::c_tree;
use std::conv;

lazy dmut __LAST_LABEL_ID__ = copy [0us];

/*
 * The function declarations of the translation unit, by assembler name. The calls to a function
 * and the frame defining it must share one FUNCTION_DECL, otherwise GCC sees every call as one to
 * an external function without a body, and can neither inline nor clone it.
 */
lazy mut __FUNCTION_DECLS__: [[c8] => mut tree_t] = copy [];

extern (C) fn ymir_get_global_context_bind()-> tree_t;

/**
 * @returns: the global context for global var declarations
 * */
pub fn ymir_get_global_context()-> tree_t {
    ymir_get_global_context_bind()
}

/**
 * @params:
 *     - loc: the location of the declaration
 *     - name: the name of the variable to declare
 *     - type: the type of the variable to declare
 * @returns: the tree of the variable declaration
 */
pub fn varDeclTree(loc: &Word, name: [c8], type: tree_t)-> tree_t {
    return c_binding_build_var_decl(wordToLocation(loc), name.toStringZ(), type);
}

/**
 * @params:
 *     - loc: the location of the declaration
 *     - name: the name of the parameter to declare
 *     - type: the type of the parameter to declare
 * @returns: the tree of a parameter decl
 */
pub fn paramDeclTree(loc: &Word, name: [c8], type: tree_t)-> tree_t {
    return c_binding_build_param_decl(wordToLocation(loc), name.toStringZ(), type);
}

/**
 * Build a label tree.
 * @params:
 *     - loc: the location of the label
 *     - context: the context of declaration of the label
 *     - label: the name of the label
 * */
pub fn labelDeclTree(loc: &Word, context: tree_t, name: [c8])-> tree_t {
    let labelId = name ~ "["s8 ~ (__LAST_LABEL_ID__[0] + 1us).to![c8] () ~ "]"s8;
    __LAST_LABEL_ID__[0] += 1us;

    let decl = c_binding_build_label_decl(wordToLocation(loc), labelId.toStringZ());
    c_binding_set_decl_context(decl, context);

    return decl;
}

/**
 * @returns: the function decl tree of the function `name` in the translation unit. The first
 *           request creates it as an external function of type `type`, the next ones get that
 *           same declaration back, whatever their type.
 * @params:
 *    - loc: the location of the declaration
 *    - name: the mangled name of the function
 *    - type: the type of the function
 */
pub fn functionDeclTree(loc: &Word, name: [c8], type: tree_t)-> tree_t {
    if let Ok(fnDecl) = __FUNCTION_DECLS__[name] {
        return fnDecl;
    }

    let fnDecl = unregisteredFunctionDeclTree(loc, name, type);
    __FUNCTION_DECLS__[name] = fnDecl;

    return fnDecl;
}

/**
 * @returns: a new function decl tree, that calls by name will not use
 * @params:
 *    - loc: the location of the declaration
 *    - name: the mangled name of the function
 *    - type: the type of the function
 */
pub fn unregisteredFunctionDeclTree(loc: &Word, name: [c8], type: tree_t)-> tree_t {
    let fnDecl = c_binding_build_function_decl(wordToLocation(loc), name.toStringZ(), type);
    setAsmName(fnDecl, name);

    return fnDecl;
}

/**
 * Set the assembly name of a declaration
 * @params:
 *    - name: the mangled name
 * */
pub fn setAsmName(decl: tree_t, name: [c8]) {
    c_binding_set_asm_name(decl, name.toStringZ());
}

/**
 * @returns: the assembly name of a declaration
 * */
pub fn getAsmName(decl: tree_t)-> [c8] {
    unsafe {
        c_binding_get_asm_name(decl).fromStringZ()
    }
}

/**
 * Set the arguments of a declaration(e.g. parameters of a function decl)
 * */
pub fn setDeclArguments(decl: tree_t, arguments: [tree_t]) {
    c_binding_set_decl_arguments(decl, cast!u64(arguments.len), arguments.ptr);
}

/**
 * Build a result declaration
 * */
pub fn buildResultDecl(loc: &Word, type: tree_t)-> tree_t {
    c_binding_build_result_decl(wordToLocation(loc), type)
}

/**
 * Build a declaration tree
 * */
pub fn buildDeclTree(loc: &Word, type: tree_t, decl: tree_t)-> tree_t {
    c_binding_build_decl(wordToLocation(loc), type, decl)
}
