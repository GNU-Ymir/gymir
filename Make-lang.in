

GYC_INSTALL_NAME := $(shell echo gyc|sed '$(program_transform_name)')
GYC_TARGET_INSTALL_NAME := $(target_noncanonical)-$(shell echo gyc|sed '$(program_transform_name)')

ROOT_DIR:=$(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))


ymir: ymir1$(exeext)
 
.PHONY: ymir

GYC_INCLUDES = -I$(srcdir)/../include -I$(srcdir)/ -I$(srcdir)/gcc -I../gcc -I$(srcdir)/../libcpp/include

# Single source of truth for the midgard stdlib version gyc links against is
# MIDGARD_VERSION in ymir/bootstrap/YMIR_VERSION (bootstrap/ is already a hard
# build dependency of ymir1, see ymir/libymirc.a below) - avoid duplicating it
# as a literal in gycspec.c.  The major.minor form names the libraries and the
# include directory; the full form is only reported by `gyc --version`.
MIDGARD_VERSION := $(shell sed -nE 's/^MIDGARD_VERSION=([0-9]+\.[0-9]+).*/\1/p' $(srcdir)/ymir/bootstrap/YMIR_VERSION)
MIDGARD_FULL_VERSION := $(shell sed -nE 's/^MIDGARD_VERSION=(.+)/\1/p' $(srcdir)/ymir/bootstrap/YMIR_VERSION)

# The date of that midgard tag cannot be derived from this source tree: yruntime
# is not part of the build, and `make` has no business going to the network to
# ask.  Release builds resolve it from the remote once and hand it to make in the
# environment (see docker/Dockerfile.gyc); anywhere else it stays empty and
# gycspec.c prints the midgard version without a date.
MIDGARD_VERSION_DATE ?=

# Likewise for the frontend version `gyc --version` reports: it is the version
# of the ymirc release this gyc is built from, i.e. bootstrap's own gyllir.toml
# `version` - the very value bootstrap/tools/set-version.sh bakes into ymirc as
# __YMIR_VERSION_FULL__, so the driver and the frontend can never disagree.
YMIR_FULL_VERSION := $(shell sed -nE 's/^version = "([^"]+)".*/\1/p' $(srcdir)/ymir/bootstrap/gyllir.toml | head -n1)

# Date printed next to it, in the YYYYMMDD form GCC uses for its own DATESTAMP:
# the date of the bootstrap tag this gyc is built from - release builds check
# that tag out, see docker/Dockerfile.gyc.  Development builds sit on a commit
# the version has not been tagged on yet, so fall back to the date of whatever
# bootstrap commit is checked out; a source tree with no git at all leaves this
# empty and gycspec.c then prints the version without a date.
YMIR_VERSION_DATE := $(shell git -C $(srcdir)/ymir/bootstrap for-each-ref --format='%(creatordate:format:%Y%m%d)' 'refs/tags/$(YMIR_FULL_VERSION)' 2>/dev/null)
ifeq ($(YMIR_VERSION_DATE),)
YMIR_VERSION_DATE := $(shell git -C $(srcdir)/ymir/bootstrap log -1 --format=%cd --date=format:%Y%m%d 2>/dev/null)
endif

# These must not go through DRIVER_DEFINES: gcc/Makefile.in assigns that one
# with `=` *after* it includes the per-language fragments, so anything appended
# to it here is silently dropped and gycspec.c falls back to its built-in
# literals.
YMIR_VERSION_DEFINES = \
	-DLIBYMIDGARD_VERSION='"$(MIDGARD_VERSION)"' \
	-DMIDGARD_FULL_VERSION='"$(MIDGARD_FULL_VERSION)"' \
	-DMIDGARD_VERSION_DATE='"$(MIDGARD_VERSION_DATE)"' \
	-DYMIR_FULL_VERSION='"$(YMIR_FULL_VERSION)"' \
	-DYMIR_VERSION_DATE='"$(YMIR_VERSION_DATE)"'

CFLAGS-ymir/gycspec.o += $(DRIVER_DEFINES) $(YMIR_VERSION_DEFINES)
ymir/gycspec.o: $(CORETYPES_H) $(PLUGIN_HEADERS) $(INSN_ATTR_H)

# Driver
GYC_OBJS = $(GCC_OBJS) ymir/gycspec.o
 
gyc$(exeext): $(GYC_OBJS) $(EXTRA_GCC_OBJS) libcommon-target.a $(LIBDEPS)
	+$(LINKER) $(ALL_LINKERFLAGS) $(LDFLAGS) $(GYC_INCLUDES) -o $@ \
	  $(GYC_OBJS) $(EXTRA_GCC_OBJS) libcommon-target.a \
	  $(EXTRA_GCC_LIBS) $(LIBS)


WARN_YFLAGS = -Wall -Wdeprecated $(NOCOMMON_FLAG)
ALL_YFLAGS = $(PICFLAG) $(ALIASING_FLAGS) $(COVERAGE_FLAGS) $(WARN_YFLAGS) -O3
ALL_GYMIRFLAGS = -O3 $(PICFLAG) -fv

YCOMPILE.base = $(CXX) $(NO_PIE_CFLAGS) -c $(ALL_YFLAGS) $(INCLUDES) -o $@ -std=c++17
YCOMPILE = $(YCOMPILE.base) -MT $@ -MMD -MP -MF $(@D)/$(DEPDIR)/$(*F).TPo
YPOSTCOMPILE = @mv $(@D)/$(DEPDIR)/$(*F).TPo $(@D)/$(DEPDIR)/$(*F).Po
YLINKER = /usr/bin/gyc $(NO_PIE_CFLAG) $(ALL_GYMIRFLAGS) -nomidgardlib -lstdc++

# Left to itself the bootstrap gyc appends a midgard runtime of its own at the
# end of the link line - but the version it appends is the one *it* was built
# with (LIBYMIDGARD_VERSION baked into its gycspec.o), and ymir/libymirc.a
# below is not compiled against that one.  gyllir builds it against the std
# bootstrap's gyllir.lock pins, cloned and built into bootstrap/.deps/std, and
# the two only agree until a bootstrap lags a midgard release.  When they
# disagree the mismatch reaches the link as an ABI one, not as a missing file:
# 1.4 making std::stream's lazy globals thread-local left libymirc.a's TLS
# reference to __PRINT_SET__ against the 1.3 archive's plain-data definition.
# Nor can the runtime be named from MIDGARD_VERSION: that is the midgard the
# gyc being built will ship, which nothing guarantees is installed on the
# machine building it (the release build's toolchain carries only its own).
# So turn the injection off with -nomidgardlib and name the installed midgard
# runtime libymirc.a is compiled against explicitly, along with the four
# libraries the driver used to bring in behind it.  They belong at
# the *end* of the link line, after ymir/libymirc.a - static archives only
# resolve backwards - which is where the driver put them and why YLINKER above
# no longer carries them.
#
# That midgard is YMIR_BOOTSTRAP_MIDGARD_VERSION in this repo's own YMIR_VERSION
# (not bootstrap's copy, whose MIDGARD_VERSION release builds overwrite with
# the one being shipped, see docker/Dockerfile.gyc).  Release builds hand it to
# make in the environment, so the value docker/Dockerfile.gyc installs (from
# that midgard's yruntime release) is the one linked here.
YMIR_BOOTSTRAP_MIDGARD_VERSION ?= $(shell sed -nE 's/^YMIR_BOOTSTRAP_MIDGARD_VERSION=(.+)/\1/p' $(srcdir)/ymir/YMIR_VERSION)
YMIR_BOOTSTRAP_MIDGARD_SHORT_VERSION := $(shell echo '$(YMIR_BOOTSTRAP_MIDGARD_VERSION)' | sed -nE 's/^([0-9]+\.[0-9]+).*/\1/p')
ifeq ($(YMIR_BOOTSTRAP_MIDGARD_SHORT_VERSION),)
$(error YMIR_BOOTSTRAP_MIDGARD_VERSION ('$(YMIR_BOOTSTRAP_MIDGARD_VERSION)') is not a <major>.<minor>... version - see ymir/YMIR_VERSION)
endif
YMIR_RUNTIME_LIBS = -lgymidgard-debug_$(YMIR_BOOTSTRAP_MIDGARD_SHORT_VERSION) -lgc -lpthread -lm -ldwarf


# The same disagreement one stage earlier, on the include side.  /usr/bin/gyc
# resolves `use std::...` against /usr/include/ymir/<the midgard *it* was built
# with>, so left alone the binding below compiles against a std that is not the
# one ymir/libymirc.a was built from - an ABI mismatch again rather than a
# missing file.  The version component of that path is baked into the bootstrap
# compiler's own ymirc as global::common::MIDGARD_VERSION, and no flag spells
# it: -iprefix replaces only the /usr part, and -nostdinc drops the core package
# altogether (it is what the runtime itself is built with, and it takes the
# implicit `use ::core` with it, so the binding stops compiling).  Which is why
# gyllir stages the std it pins under the bootstrap compiler's version number
# rather than under its own - point -iprefix at that staging tree and the
# binding and libymirc.a share one std by construction.  It is written by the
# gyllir run in the ymir/libymirc.a rule below, which the binding already waits
# on, so there is nothing else to order here.
MIDGARD_IPREFIX = $(ROOT_DIR)/$(srcdir)/ymir/bootstrap/.deps/std/.iprefix

GYMIRCOMPILE.base = /usr/bin/gyc $(NO_PIE_CFLAGS) -c $(ALL_GYMIRFLAGS) -iprefix $(MIDGARD_IPREFIX) -o $@
GYMIRCOMPILE = $(GYMIRCOMPILE.base)

# The compiler proper
 
ymir_OBJS = \
	ymir/ymir1.o \
    ymir/tree_c_bind.o \
    ymir/libbinding.a \
    ymir/libymirc.a \
	$(END)	

bootstrap_objs := $(shell find $(ROOT_DIR)/$(srcdir)/ymir/bootstrap/src | grep [.]yr)
binding_objs := $(shell find $(ROOT_DIR)/$(srcdir)/ymir/binding | grep [.]yr)

ymir1$(exeext): attribs.o $(ymir_OBJS) $(BACKEND) $(LIBDEPS)
	+$(YLINKER) $(ALL_LINKERFLAGS) $(LDFLAGS) -o $@ \
	attribs.o $(ymir_OBJS) $(D_TARGET_OBJS) $(BACKEND) $(LIBS) $(BACKENDLIBS) libbackend.a \
	$(YMIR_RUNTIME_LIBS)

ymir/libbinding.a: $(binding_objs) ymir/libymirc.a
	  $(GYMIRCOMPILE) -I$(ROOT_DIR)/$(srcdir)/ymir/bootstrap/src/ymirc.yr $(srcdir)/ymir/binding/__lib__.yr -c -o $(srcdir)/ymir/binding/libbinding.o ; \
      cp $(srcdir)/ymir/binding/libbinding.o $@

ymir/tree_%.o: ymir/binding/binding/tree/%.cc ymir/libymirc.a
	  $(YCOMPILE) $(GYC_INCLUDES) $<
	  $(YPOSTCOMPILE)

ymir/libymirc.a: $(bootstrap_objs)
	  cd $(srcdir)/ymir/bootstrap/ ; gyllir build --release || (echo "gyllir failed $$?"; sh -c 'exit 1') ; cd - ; \
	  cp $(srcdir)/ymir/bootstrap/libymirc.a $@

ymir.all.cross: 
 
ymir.start.encap: gyc$(exeext)
ymir.rest.encap:

selftest-ymir:

ymir.install-common: installdirs
	-rm -f $(DESTDIR)$(bindir)/$(GYC_INSTALL_NAME)$(exeext)
	$(INSTALL_PROGRAM) gyc$(exeext) $(DESTDIR)$(bindir)/$(GYC_INSTALL_NAME)$(exeext)
	rm -f $(DESTDIR)$(bindir)/$(GYC_TARGET_INSTALL_NAME)$(exeext); \
	( cd $(DESTDIR)$(bindir) && \
      $(LN) $(GYC_INSTALL_NAME)$(exeext) $(GYC_TARGET_INSTALL_NAME)$(exeext) ); \
 
# Required goals, they still do nothing
ymir.install-man:
ymir.install-info:
ymir.install-pdf:
ymir.install-plugin:
ymir.install-html:
ymir.info:
ymir.dvi:
ymir.pdf:
ymir.html:
ymir.man:
ymir.mostlyclean:
ymir.clean:
ymir.distclean:
ymir.maintainer-clean:


# make uninstall
ymir.uninstall:
	-rm -f gyc$(exeext) ymir1$(exeext)
	-rm -f $(ymir_OBJS)
 
# Used for handling bootstrap
ymir.stage1: stage1-start
	-mv ymir/*$(objext) stage1/ymir
ymir.stage2: stage2-start
	-mv ymir/*$(objext) stage2/ymir
ymir.stage3: stage3-start
	-mv ymir/*$(objext) stage3/ymir
ymir.stage4: stage4-start
	-mv ymir/*$(objext) stage4/ymir
ymir.stageprofile: stageprofile-start
	-mv ymir/*$(objext) stageprofile/ymir
ymir.stagefeedback: stagefeedback-start
	-mv ymir/*$(objext) stagefeedback/ymir

check-ymir: check-gyc
lang_checks += check-gyc
lang_checks_parallelized += check-gyc
check_gyc_parallelize = 10
